local.file_match "system_var_logs" {
  path_targets = [{
    "__path__" = "/var/log/*.log",
    "job"      = "var_logs",
  }]
}

loki.source.file "logs_scrape" {
  targets    = local.file_match.system_var_logs.targets
  forward_to = [loki.write.local_loki.receiver]
}

loki.write "local_loki" {
  endpoint {
    url = "http://local_loki:3100/loki/api/v1/push"
  }
}
